graph "Transparency" {
    graph [
        layout="neato",
        bgcolor="#0000ff11",
        start="11"
    ];
    node [
        fontsize="14",
        style="filled",
        peripheries="1",
        label="",
        shape="circle",
        width="2.22"
    ];
    "2" [
        label="",
        color="#eeee0080"
    ];
    "1" [color="#ff000080"];
    "6" [color="#ee00ee80"];
    "5" [color="#0000ff80"];
    "3" [color="#00ff0080"];
    "4" [color="#00eeee80"];
    "1" -- "2";
    "5" -- "6";
    "6" -- "1";
    "3" -- "4";
    "2" -- "3";
    "4" -- "5";
}
