    subgraph cluster_0 {
        graph [
            style="filled",
            label="process #1",
            color="lightgrey",
            labelloc="t",
            labeljust="c"
        ];
        "a0" [
            style="filled",
            color="white"
        ];
        "a1" [
            style="filled",
            color="white"
        ];
        "a2" [
            style="filled",
            color="white"
        ];
        "a3" [
            style="filled",
            color="white"
        ];
    }
    subgraph cluster_1 {
