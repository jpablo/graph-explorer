              <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFF8E1">
              <tr><td bgcolor="#FAD2CF"><b>SignatureLayout</b><br/><font point-size="8">final case class · private constructor · public fields + methods</font></td></tr>
              <tr><td port="f_name" align="left" bgcolor="#EFF7F1">name: String</td></tr>
              <tr><td port="f_fields" align="left" bgcolor="#EFF7F1">fields: Vector[FieldSpec] &#8594;</td></tr>
              <tr><td port="f_instructions" align="left" bgcolor="#EFF7F1">instructions: Option[String]</td></tr>
              <tr><td port="m_inputFields" align="left">inputFields &#8594;</td></tr>
              <tr><td port="m_outputFields" align="left">outputFields &#8594;</td></tr>
              <tr><td port="m_withInstructionsOption" align="left">withInstructions(text: Option[String]) <font color="#9AA0A6" point-size="8">&#8594; Self</font></td></tr>
              <tr><td port="m_withInstructionsString" align="left">withInstructions(text: String) <font color="#9AA0A6" point-size="8">&#8594; Self</font></td></tr>
              <tr><td port="m_signatureString" align="left">signatureString: String</td></tr>
              <tr><td port="m_equalsByStructure" align="left">equalsByStructure(other: SignatureLayout): Boolean</td></tr>
              <tr><td port="m_dumpState" align="left">dumpState &#8594;</td></tr>
              <tr><td port="m_dumpJson" align="left">dumpJson: String</td></tr>
