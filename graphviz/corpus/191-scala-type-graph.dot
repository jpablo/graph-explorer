/*
 * Type/function graph rooted in Program.scala and extended with Predict.scala,
 * Prediction.scala, and SignatureLayout.scala.
 * Scala mapping: non-private constructor fields and declared methods are public
 * members; inherited/protected/private members are excluded. Parameters consume
 * types (gray), fields/returns produce types (green), and Either's error branch
 * is red. Vector and Option are transparent 0..* / 0..1 edge annotations.
 * Project and non-ubiquitous external types are linked leaves, grouped by their
 * declaring Scala package. Generic type parameters and primitives stay inline.
 * EXCEPTION: public companion/given implementation members are included for
 * reviewed types so their complete construction surface remains visible.
 */
digraph "ProgramTypeFunctionGraph" {
    graph [
        fontname="Helvetica",
        fontsize="11",
        label="dspy4s",
        rankdir="LR",
        bgcolor="#FbFbFd",
        nodesep="0.35",
        pad="0.2",
        ranksep="0.85",
        compound="true"
    ];
    subgraph "cluster_package_core_contracts" {
        graph [
            compound="true",
            bgcolor="#FbFbFd",
            style="filled,rounded",
            label="dspy4s.core.contracts",
