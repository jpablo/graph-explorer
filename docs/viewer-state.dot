digraph "G" {
    graph [
        nodesep="0.5",
        rankdir="TB",
        label="Data Flow",
        pad=".1",
        labelloc="t",
        ranksep=".5",
        layout="dot",
        bgcolor="#f2baba",
        splines="spline"
    ];
    node [
        shape="polygon",
        style="filled",
        fillcolor="#f6eeee",
        peripheries="1"
    ];
    edge [
        decorate="false",
        constraint="true"
    ];
    "fullGraphV" [
        label="fullGraphV *",
        fillcolor="#cfee96"
    ];
    "versionedText" [fillcolor="#fdefaa"];
    "versionedFullGraphV" [fillcolor="#fdefaa"];
    "visibleDOT"
    "visibleAST"
    "sourceText"
    "svgDiagramElement"
    "sourceAST"
    "visibleGraph"

    "sourceText" -> "versionedText" [dir="both"];
    "versionedText" -> "sourceAST" [dir="both"];
    "sourceAST" -> "versionedFullGraphV" [dir="both"];
    "versionedFullGraphV" -> "fullGraphV" [dir="both"];

    "fullGraphV" -> "visibleGraph";
    "visibleGraph" -> "visibleAST";
    "visibleAST" -> "visibleDOT";

    "visibleDOT" -> "svgDiagramElement";
}
