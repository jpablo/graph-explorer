digraph G {
    node [shape = rectangle]

    source -> fullAST [label = "buildAST\nattachInternalAttributes"]
    fullAST -> fullGraph [label = toViewerGraph]
    fullAST -> visibleAST [label = removeHiddenNodes]
    visibleAST -> visibleDOT [label = toDot]
    visibleAST -> visibleGraph

    visibleDOT -> svgDiagramElement [label = toSvg]
    svgDiagramElement -> svgDotDiagram
}
