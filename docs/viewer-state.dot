digraph "G" {
    graph [
        nodesep="0.5",
        rankdir="TB",
        label="Phases",
        pad=".1",
        labelloc="t",
        ranksep=".5",
        layout="dot",
        bgcolor="#f2baba",
        splines="spline"
    ];
    node [
        style="filled",
        peripheries="1",
        fillcolor="#f6eeee"
    ];
    edge [
        decorate="false",
        constraint="true"
    ];
    "fullGraphV" [
        label="fullGraphV *",
        fillcolor="#cfee96"
    ];
    "versionedText";
    "versionedFullGraphV";
    "visibleDOT";
    "visibleAST";
    "sourceText";
    "svgDiagramElement";
    "sourceAST";
    "visibleGraph";
    "versionedFullGraphV" -> "fullGraphV" [dir="both"];
    "sourceText" -> "versionedText" [dir="both"];
    "sourceAST" -> "versionedFullGraphV" [dir="both"];
    "visibleAST" -> "visibleDOT";
    "fullGraphV" -> "visibleGraph";
    "visibleGraph" -> "visibleAST";
    "visibleDOT" -> "svgDiagramElement";
    "versionedText" -> "sourceAST" [dir="both"];
}
